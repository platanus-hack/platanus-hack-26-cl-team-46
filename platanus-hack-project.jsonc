{
  // Your project's name, as it will appear on the voting page.
  "project-name": "Mayday",

  // Short one-line summary of your project (in Spanish).
  "project-oneliner-spanish": "Simulador de hackeos: atacamos tu propia app en un sandbox y vives el incidente en tiempo real.",

  // Brief description of your project (in Spanish).
  "project-description-spanish": "Entregas el repo de GitHub de tu proyecto y lo desplegamos en un sandbox. Una IA encuentra sus vulnerabilidades, un agente lo hackea y tú vives el incidente en tiempo real: te llegan correos de clientes y alertas de Sentry o Datadog, y respondes conversando con tu agente de código. Tus acciones cambian la app desplegada de verdad: si cambias la contraseña robada pero no rotas el JWT_SECRET, el atacante sigue adentro. Al final recibes un debrief con lo que pasó, dónde estaba el error y la comparación con un caso real.",

  // Public URL where your project is deployed and running.
  // Must be a valid URL, for example: https://my-project.vercel.app
  // If your project is an app, put the download link here instead
  // (for example, a URL to download an APK).
  "deploy-url": "https://mayday.rip"
}
