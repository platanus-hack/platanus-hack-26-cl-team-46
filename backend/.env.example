# --- Obligatorias
RENDER_API_KEY=rnd_xxx

# --- GitHub: mirrors de cada sandbox en la org (necesario para los modos auto y agent)
# PAT fine-grained con acceso a la org: Administration (RW) + Contents (RW).
# Se acepta cualquiera de los dos nombres.
GITHUB_HACK26_ORG_TOKEN=
# GITHUB_TOKEN=
GITHUB_ORG=hack26-sandboxes

# Login con GitHub (GitHub App, src/auth). Sin las tres primeras, el login queda apagado y la API abierta.
# Crear en GitHub → Settings → Developer settings → GitHub Apps (no requiere revisión de GitHub):
#   Callback URL: <backend>/auth/github/callback · Setup URL: <frontend>/start/repos (Redirect on update)
#   Permisos de repo: Contents (read) y Metadata (read) · Webhook: desactivado · "Any account" puede instalarla
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# SESSION_SECRET=              (32+ caracteres: openssl rand -base64 48)
# GITHUB_APP_SLUG=             (github.com/apps/<slug>: link "comparte más repos")
# FRONTEND_URL=                (default: primer origen de CORS_ORIGIN; prod: https://mayday.rip)
# AUTH_CALLBACK_URL=           (default: PUBLIC_BACKEND_URL/auth/github/callback)
# ADMIN_GITHUB_LOGINS=         (logins del equipo que ven todos los sandboxes, separados por coma)

# --- Agente de deploy (fallback con IA en VMs de Conductor)
# Secreto maestro de /agent/*. Cada agente recibe un token derivado que solo sirve para su sandbox.
# Generar con: node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
AGENT_API_SECRET=
# URL pública del backend: los agentes la llaman desde sus VMs.
PUBLIC_BACKEND_URL=https://xxx.onrender.com
CONDUCTOR_API_KEY=
# CONDUCTOR_PROJECT_ID=250d6454-3b06-4b69-bc80-f0c6e7307a34   (proyecto hack-26: base de las VMs)
# Rama base de las VMs de los agentes (Conductor usa main si no se indica).
# CONDUCTOR_PROJECT_BRANCH=main
# Contraseñas de los roles de Postgres de cada sandbox (HMAC). Si falta, se usa AGENT_API_SECRET. Debe ser estable.
# SANDBOX_DB_SECRET=
# AGENT_MODEL=opus-5-5-1m
# AGENT_EFFORT=medium
# AGENT_MAX_PLANS=6
# AGENT_ARCHIVE_ON_FINISH=false
# Credenciales globales de Conductor que se tapan (vacías) en las VMs de los agentes (lista separada por comas)
# CONDUCTOR_AGENT_BLANK_ENV=RENDER_API_KEY,GITHUB_TOKEN,GITHUB_HACK26_ORG_TOKEN,AGENT_API_SECRET,OPENAI_API_KEY,ELEVENLABS_API_KEY,CLOUDFLARE_API_TOKEN,DATABASE_URL

# --- Simulación: roles que corren en el backend con la API de Claude (SimulationBrain)
# Sin key, los 5 roles corren como threads de Conductor (comportamiento anterior).
ANTHROPIC_API_KEY=
# SIM_API_ROLES=infra,observer,generator   (vacío = todos en Conductor)
# SIM_MODEL_CONTEXT=claude-haiku-5-5        SIM_EFFORT_CONTEXT=low
# SIM_MODEL_GENERATOR=claude-sonnet-5-5     SIM_EFFORT_GENERATOR=low
# SIM_MODEL_OBSERVER=claude-sonnet-5-5      SIM_EFFORT_OBSERVER=medium
# SIM_MODEL_DEBRIEF=claude-opus-5-5         SIM_EFFORT_DEBRIEF=high
# SIM_MAX_INCIDENTS=3                       (vulns que se juegan antes de cerrar con el debrief)

# --- Opcionales (defaults entre paréntesis)
# PORT=3001
# CORS_ORIGIN=http://localhost:3000
# PREVIEW_URL_TEMPLATE=       (proxy de la app del sandbox para el navegador simulado; prod: https://{sandbox}.preview.mayday.rip, local: http://{sandbox}.preview.localhost:3001)
# DATA_DIR=.data
# RENDER_OWNER_ID=            (se detecta solo con la API key)
# RENDER_REGION=oregon
# RENDER_SERVICE_PLAN=free    (cambiar a starter cuando lleguen los créditos)
# RENDER_POSTGRES_MODE=shared (shared: 1 instancia + 1 DB por sandbox | dedicated: 1 instancia por sandbox)
# RENDER_POSTGRES_PLAN=free   (basic_256mb con créditos)
# RENDER_SHARED_POSTGRES_NAME=hack26-shared-pg

# --- Hinty (antes Clicky): el profesor en pantalla del simulador (src/clicky). Sin keys, sus rutas responden 503.
# Cerebro: Claude con ANTHROPIC_API_KEY (la misma de la simulación, más abajo). Mira la captura y lo
# que pasa en el simulacro y decide qué pista dar, qué decir y qué marcar.
# Voz de Clicky y reconocimiento de lo que dice el usuario.
ELEVENLABS_API_KEY=
# CLICKY_BRAIN_MODEL=claude-opus-5-5     (claude-sonnet-5-5 responde el primer beat antes: ~1,8 s vs 2,5–7 s)
# CLICKY_BRAIN_EFFORT=low                (low | medium | high | xhigh | max; menos razonamiento = respuesta antes)
# CLICKY_VOICE_ID=kcQkGnn0HAT2JRDQ4Ljp   (voz de la biblioteca de ElevenLabs; default: Norah, español latino)
# CLICKY_TTS_MODEL=eleven_flash_v2_5
# CLICKY_TTS_FORMAT=mp3_22050_32
# CLICKY_STT_LIVE_MODEL=scribe_v3_live    (dictado en vivo mientras se mantiene espacio)
# CLICKY_STT_MODEL=scribe_v3              (respaldo: se sube el audio entero si el dictado en vivo falla)
# CLICKY_MOCK=false                       (true: respuestas de ensayo, sin llamar a Claude ni ElevenLabs)
# CLICKY_RATE_LIMIT=20                    (preguntas por minuto por IP)
# CLICKY_MAX_QUESTIONS_PER_SIM=80
# CLICKY_MAX_TTS_CHARS_PER_SIM=30000      (al pasarlo, Clicky usa la voz del navegador)

# ─── Motor de hacking real en Modal (engine/docs/MODAL.md) ───
# Con las tres variables, las simulaciones nuevas usan el motor real: primera pasada
# que ataca el sandbox de verdad, informe, repetición con reloj humano y verificación real.
# Sin ellas, el hacker sigue siendo el agente emulado.
# ENGINE_URL=https://<workspace>--hack26-engine-api.modal.run
# ENGINE_MODAL_KEY=wk-...
# ENGINE_MODAL_SECRET=ws-...
# ENGINE_REPLAY_STEP_SECONDS=30           (segundos entre pasos del atacante en el simulacro)
# ENGINE_PLUGIN=auto                      (auto | generic | apuntes | tasks; auto elige solo)

# --- Cupo y limpieza de sandboxes (Render Hobby: 25 servicios contando Postgres)
# RENDER_SERVICE_LIMIT=25
# SANDBOX_MAX_PER_USER=3          (al crear uno más se liberan los inactivos del usuario)
# SANDBOX_IDLE_TTL_HOURS=3        (sin actividad del usuario → se borra)
# SANDBOX_FAILED_TTL_HOURS=1
# SANDBOX_DUPLICATE_GRACE_MIN=20  (copias del mismo repo y dueño sin uso)
# SANDBOX_GC_INTERVAL_MIN=10
