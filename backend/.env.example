# --- Obligatorias
RENDER_API_KEY=rnd_xxx

# --- GitHub: mirrors de cada sandbox en la org (necesario para los modos auto y agent)
# PAT fine-grained con acceso a la org: Administration (RW) + Contents (RW).
# Se acepta cualquiera de los dos nombres.
GITHUB_HACK26_ORG_TOKEN=
# GITHUB_TOKEN=
GITHUB_ORG=hack26-sandboxes

# --- Agente de deploy (fallback con IA en VMs de Conductor)
# Secreto maestro de /agent/*. Cada agente recibe un token derivado que solo sirve para su sandbox.
# Generar con: node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
AGENT_API_SECRET=
# URL pública del backend: los agentes la llaman desde sus VMs.
PUBLIC_BACKEND_URL=https://xxx.onrender.com
CONDUCTOR_API_KEY=
# CONDUCTOR_PROJECT_ID=250d6454-3b06-4b69-bc80-f0c6e7307a34   (proyecto hack-26: base de las VMs)
# Rama base de las VMs de los agentes (Conductor usa main si no se indica).
# CONDUCTOR_PROJECT_BRANCH=main
# AGENT_MODEL=opus-5-5-1m
# AGENT_EFFORT=medium
# AGENT_MAX_PLANS=6
# AGENT_ARCHIVE_ON_FINISH=false

# --- Opcionales (defaults entre paréntesis)
# PORT=3001
# CORS_ORIGIN=http://localhost:3000
# DATA_DIR=.data
# RENDER_OWNER_ID=            (se detecta solo con la API key)
# RENDER_REGION=oregon
# RENDER_SERVICE_PLAN=free    (cambiar a starter cuando lleguen los créditos)
# RENDER_POSTGRES_MODE=shared (shared: 1 instancia + 1 DB por sandbox | dedicated: 1 instancia por sandbox)
# RENDER_POSTGRES_PLAN=free   (basic_256mb con créditos)
# RENDER_SHARED_POSTGRES_NAME=hack26-shared-pg

# --- Clicky: copiloto en pantalla del simulador (src/clicky). Sin keys, sus rutas responden 503.
# Cerebro (mira la captura y decide qué decir y marcar).
OPENAI_API_KEY=
# Voz de Clicky y reconocimiento de lo que dice el usuario.
ELEVENLABS_API_KEY=
# CLICKY_BRAIN_MODEL=gpt-6-luna
# CLICKY_BRAIN_EFFORT=low                (none | low | medium | high | default; menos razonamiento = respuesta antes)
# CLICKY_VOICE_ID=kcQkGnn0HAT2JRDQ4Ljp   (voz de la biblioteca de ElevenLabs; default: Norah, español latino)
# CLICKY_TTS_MODEL=eleven_flash_v2_5
# CLICKY_TTS_FORMAT=mp3_22050_32
# CLICKY_STT_LIVE_MODEL=scribe_v3_live    (dictado en vivo mientras se mantiene espacio)
# CLICKY_STT_MODEL=scribe_v3              (respaldo: se sube el audio entero si el dictado en vivo falla)
# CLICKY_MOCK=false                       (true: respuestas de ensayo, sin llamar a OpenAI ni ElevenLabs)
# CLICKY_RATE_LIMIT=20                    (preguntas por minuto por IP)
# CLICKY_MAX_QUESTIONS_PER_SIM=80
# CLICKY_MAX_TTS_CHARS_PER_SIM=30000      (al pasarlo, Clicky usa la voz del navegador)
