PORT=3000
DATABASE_URL=postgres://apuntes:apuntes@localhost:5433/apuntes
JWT_SECRET=cambia-esto
NODE_ENV=development
# Duración de la sesión (formato de jsonwebtoken)
JWT_EXPIRES_IN=30d
# true = borra y vuelve a sembrar la base al arrancar
SEED_RESET=false
# Monitoreo de errores (opcional; sin DSN no se envía nada)
SENTRY_DSN=
# Analítica de producto (opcional; sin key no se envía nada)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
