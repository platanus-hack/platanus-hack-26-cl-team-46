NEXT_PUBLIC_API_URL=http://localhost:3001

# Login con GitHub (OAuth App, sin scopes). Solo servidor: se leen en runtime, no al buildear.
# Crear en GitHub → Settings → Developer settings → OAuth Apps (no requiere revisión de GitHub).
# Callback: <origen>/api/auth/github/callback. Una app por origen (local y producción).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Origen público para armar el callback (en producción: https://mayday.rip). Opcional en local.
PUBLIC_APP_URL=
